---
import "../styles/global.css";
import Navbar from "../components/navbar/Navbar.astro";
import Footer from "../components/Footer.astro";
import CopyEmailToast from "../components/CopyEmailToast.astro";

interface Props {
  title?: string;
  class?: string;
}

const { title = "Default Title", class: className } = Astro.props;
---

<!doctype html>
<html class="scroll-smooth scroll-pt-16 md:scroll-pt-20" lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");

      if (savedTheme === "dark" || (!savedTheme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.setAttribute("data-theme", "dark");
      } else {
        document.documentElement.setAttribute("data-theme", "light");
      }
    </script>

    <!-- Scroll to top of page when refreshing tab on route targeting id, e.g: index/#skills"  -->
    <script is:inline>
      if ("scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }
    </script>

    <!-- Global event listener for all same-page anchor clicks -->
    <script>
      document.addEventListener("click", (event) => {
        const anchor = (event.target as HTMLElement).closest("a");
        if (!anchor) return;

        // Skip links that open in new tabs or are external JS hooks
        if (anchor.target === "_blank" || anchor.getAttribute("role") === "button") return;

        const rawHref = anchor.getAttribute("href");
        if (!rawHref) return;

        const targetUrl = new URL(anchor.href, window.location.href);
        const normalizePath = (p: string) => (p !== "/" ? p.replace(/\/$/, "") : p);

        const isSamePath = normalizePath(targetUrl.pathname) === normalizePath(window.location.pathname);

        if (isSamePath) {
          if (targetUrl.hash) {
            // Target points to an anchor on the current page (e.g., /#projects)
            const targetElement = document.querySelector(targetUrl.hash);
            if (targetElement) {
              event.preventDefault();
              targetElement.scrollIntoView({ behavior: "smooth" });
              // Update URL hash without forcing a hard browser jump
              history.pushState(null, "", targetUrl.hash);
            }
          } else {
            // Target points to the current page top (e.g., "/" while on "/")
            event.preventDefault();
            window.scrollTo({ top: 0, behavior: "smooth" });
            // Clean hash from URL if navigating back to root page
            history.pushState(null, "", targetUrl.pathname);
          }
        }
      });
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.svg" />
  </head>

  <body class:list={["flex flex-col min-h-screen pt-13 lg:pt-15", className]}>
    <Navbar />
    <slot />
    <Footer />
    <div id="toast-container" transition:persist aria-live="polite" aria-atomic="true">
      <CopyEmailToast />
    </div>
  </body>
</html>
