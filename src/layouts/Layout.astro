---
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'Default Title'} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="bg-brand w-full h-full">
			<h1 class="text-body text-display">This is display text</h1>
			<h1 class="text-white text-lead">This is lead text</h1>
			<h1 class="text-white text-body">This is body text</h1>
			<h1 class="text-white text-heading">This is heading text</h1>
			<h1 class="text-white text-subheading">This is subheading text</h1>
			<h1 class="text-white text-card-title">This is card title text</h1>
			<h1 class="text-white text-tag">This is tag text</h1>
			<h1 class="text-white text-button">This is button text</h1>
			<h1 class="text-white text-image-title">This is image title text</h1>
			<h1 class="text-white text-caption">This is caption text</h1>
		</div>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
