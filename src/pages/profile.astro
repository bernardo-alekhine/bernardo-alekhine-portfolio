---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import TextWrapper from "../components/TextWrapper.astro";
import SectionBanner from "../components/SectionBanner.astro";
import FadeIn from "../components/FadeIn.astro";
import EducationItem from "../components/profile/EducationItem.astro";
import ExperienceItem from "../components/profile/ExperienceItem.astro";
import SkillItem from "../components/profile/SkillItem.astro";
import CertificateItem from "../components/profile/CertificateItem.astro";
import LinkButton from "../components/actions/LinkButton.astro";
import ArrowIcon from "../components/icons/Arrow.astro";
import DownloadResumeIcon from "../components/icons/DownloadResume.astro";
import { education } from "../data/profile/education.ts";
import { experience } from "../data/profile/experience.ts";
import { skills } from "../data/profile/skills.ts";
import { certificates } from "../data/profile/certificates.ts";
---

<Layout title="Perfil" class="bg-main">
  <SectionBanner class="bg-section-banner mb-10">
    <h1 class="text-left text-heading text-body-color w-full">Perfil</h1>
    <p class="text-left text-lead text-body-color w-full">
      Sou estudante de ADS e conecto a lógica do desenvolvimento de software e a infraestrutura de TI à criatividade do
      Design Gráfico e UI/UX. Tenho experiência profissional com suporte e manutenção de TI somada ao Inglês avançado, o
      que me permitiu concluir cursos relevantes de ciência da computação da Universidade de Harvard por conta própria.
      Construo projetos organizados focados em resultados e sou orientado a um aprendizado rápido, contínuo e autônomo.
      Atuo Com foco em desenvolvimento de aplicações web Full-stack, na construção de layouts e experiência do usuário
      interativa e responsiva e na criação de peças de design gráfico estratégicas.
    </p>
  </SectionBanner>
  <main class="flex-1 flex flex-col gap-1">
    <Section>
      <Container class="flex flex-1 flex-col items-center gap-4">
        <TextWrapper>
          <h2 class="text-heading text-body-color pb-2">Educação</h2>
          {education.map((item) => (
            <EducationItem {...item} />
          ))}
        </TextWrapper>
      </Container>
    </Section>
    <Section>
      <Container class="flex flex-col items-center gap-4">
        <TextWrapper>
          <h2 class="text-heading text-body-color pb-2">Experiência Profissional</h2>
          <div class="flex flex-col gap-8">
            {experience.map((item) => (
              <ExperienceItem {...item} />
            ))}
          </div>
        </TextWrapper>
      </Container>
    </Section>
  </main>

  <Section>
    <Container class="flex flex-col items-center gap-4">
      <TextWrapper>
        <h2 class="text-heading text-body-color pb-2">Habilidades</h2>
        <div class="flex flex-col gap-8">
          {skills.map((item) => (
            <SkillItem {...item} />
          ))}
        </div>
      </TextWrapper>
    </Container>
  </Section>

  <Section>
    <Container class="flex flex-col items-center gap-4">
      <TextWrapper>
        <h2 class="text-heading text-body-color pb-2">Certificados</h2>
        <div class="flex flex-col gap-8">
          {certificates.map((item) => (
            <CertificateItem {...item} />
          ))}
        </div>
      </TextWrapper>
    </Container>
  </Section>

  <Section>
    <Container class="pt-4 pb-4 lg:pt-6 lg:pb-6">
      <FadeIn class="flex flex-col gap-4 justify-center text-center items-center w-full">
        <h2 class="text-heading text-brand text-center">E aí? Vamos trabalhar juntos?</h2>
        <div
          class="w-full sm:max-w-lg md:max-w-3xl flex flex-col justify-center items-center gap-3 py-5 lg:py-1"
          id="buttons"
        >
          <LinkButton title="Entre em Contato" href="/#contact" variant="solid">
            <ArrowIcon class="text-button-text-color" />
          </LinkButton>

          <LinkButton title="Baixar meu Currículo" href="#" variant="outline">
            <DownloadResumeIcon class="text-brand" />
          </LinkButton>
        </div>
      </FadeIn>
    </Container>
  </Section>
</Layout>
