---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";
import Container from "../components/Container.astro";
import SectionBanner from "../components/SectionBanner.astro";
import EducationItem from "../components/profile/EducationItem.astro";
import ExperienceItem from "../components/profile/ExperienceItem.astro";
import SkillItem from "../components/profile/SkillItem.astro";
import { education } from "../data/profile/education.ts";
import { experience } from "../data/profile/experience.ts";
import { skills } from "../data/profile/skills.ts";
---

<Layout title="Perfil" class="bg-main">
  <SectionBanner class="bg-section-banner mb-10">
    <h1 class="text-left text-heading text-body-color w-full">Perfil</h1>
    <p class="text-left text-lead text-body-color w-full">
      Sou estudante de ADS e conecto a lógica da TI à criatividade do Design Gráfico. Minha experiência com suporte e
      manutenção me trouxe a disciplina ideal para entregar projetos organizados e focados em resultados. Unindo essa
      bagagem prática ao domínio de ferramentas vetoriais e ao Inglês fluente, desenvolvo layouts e marcas de forma ágil
      e precisa.
    </p>
  </SectionBanner>
  <main class="flex-1 flex flex-col gap-1">
    <Section>
      <Container class="flex flex-1 flex-col gap-4 px-10 xl:px-16">
        <h2 class="text-heading text-body-color">Educação</h2>
        {education.map((item) => <EducationItem {...item} />)}
      </Container>
    </Section>
    <Section>
      <Container class="flex flex-col gap-4 px-10 xl:px-16">
        <h3 class="text-heading text-body-color">Experiência Profissional</h3>
        <div class="flex flex-col gap-8">
          {experience.map((item) => <ExperienceItem {...item} />)}
        </div>
      </Container>
    </Section>
  </main>

  <Section>
    <Container class="flex flex-col gap-4 px-10 xl:px-16">
      <h4 class="text-heading text-body-color">Habilidades</h4>
      <div class="flex flex-col gap-8">
        {skills.map((item) => <SkillItem {...item} />)}
      </div>
    </Container>
  </Section>
</Layout>
