---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionBanner from "../../components/SectionBanner.astro";
import Container from "../../components/Container.astro";
import TextWrapper from "../../components/TextWrapper.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => {
    const slug = project.id.split("/")[0];

    return {
      params: { slug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { Content } = await render(project);

const locale = Astro.currentLocale || "pt-BR";
const formattedDate: string = project.data.date.toLocaleDateString(locale, {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout title={project.data.title} class="bg-main">
  <SectionBanner class="bg-section-banner">
    <h1 class="text-left text-heading text-body-color w-full">{project.data.title}</h1>
    <p class="text-left text-lead text-body-color w-full">{project.data.tagline}</p>
    <div class="flex flex-row w-full gap-2">
      {project.data.tags.map((tag) => (
        <small class="text-tag text-sm bg-card-shadow-color/20 px-2 py-0.5 rounded">{tag}</small>
      ))}
    </div>
    <time class="text-left w-full text-nav-item text-sm" datetime={project.data.date.toISOString().split("T")[0]}>
      Desenvolvido em {formattedDate}
    </time>
  </SectionBanner>

  <Section class="py-4">
    <Container class="project-content flex flex-col w-full justify-center items-center mx-auto">
      <article class="px-10 xl:px-16">
        <TextWrapper class="flex flex-col gap-4">
          <Content />
        </TextWrapper>
      </article>
    </Container>
  </Section>
</Layout>
