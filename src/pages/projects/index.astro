---
import Layout from "../../layouts/Layout.astro";
import Section from "../../components/Section.astro";
import SectionBanner from "../../components/SectionBanner.astro";
import FadeIn from "../../components/FadeIn.astro";
import Container from "../../components/Container.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/cards/ProjectCard.astro";

const allProjects = await getCollection("projects");

const sortedProjects = allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Projetos" class="bg-main">
  <SectionBanner class="bg-section-banner">
    <h1 class="text-heading text-body-color w-full">Portfólio de Design e Desenvolvimento</h1>
    <p class="text-lead text-body-color w-full">
      Uma seleção de trabalhos práticos focados em identidade visual, design de marca e o desenvolvimento de soluções
      digitais sob medida.
    </p>
  </SectionBanner>

  <main>
    <Section class="py-8">
      <Container class="w-full flex flex-wrap gap-6 items-center justify-center justify-items-center px-2 md:px-">
        <FadeIn>
          {sortedProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </FadeIn>
      </Container>
    </Section>
  </main>
</Layout>
