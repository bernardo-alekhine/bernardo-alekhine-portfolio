---
import Layout from "../layouts/Layout.astro";
import SectionBanner from "../components/SectionBanner.astro";
---

<Layout title="Projetos" class="bg-main">
  <main class="flex-1 flex flex-col">
    <SectionBanner>
      <h1 class="text-left text-heading text-body-color w-full">Portfólio de Design e Desenvolvimento</h1>
      <p class="text-left text-lead text-body-color w-full">
        Uma seleção de trabalhos práticos focados em identidade visual, design de marca e o desenvolvimento de soluções
        digitais sob medida.
      </p>
    </SectionBanner>
  </main>
</Layout>
