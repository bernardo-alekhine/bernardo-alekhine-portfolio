---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "solid" | "outline";
}

const { href = "#", variant = "solid", class: className, ...restProps } = Astro.props;

// TODO: Decrease padding and remove large fixed size button width, use percentage to fit parent container intstead
const baseStyles = `
  w-full
  flex
  items-center justify-center
  h-[2.8em]
  px-[1.25em]
  gap-[0.7em]
  transition-colors
  text-button
  rounded-3xl lg:rounded-4xl
  select-none
  [&>svg]:select-none
  transition-colors
`;

const variantClasses = {
  solid: "bg-brand text-button-text-color hover:bg-button-primary-hover duration-200",
  outline:
    "border border-brand text-brand hover:border-button-primary-hover hover:bg-button-outline-hover duration-200",
};
---

<a href={href} class:list={[baseStyles, variantClasses[variant], className]} {...restProps}>
  <slot />
</a>
