---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  variant?: 'solid' | 'outline';
}

const { variant = 'solid', class: className, ...rest } = Astro.props;

// TODO: Decrease padding and remove large fixed size button width, use percentage to fit parent container intstead
const baseStyles = `
  w-full
  inline-flex
  items-center justify-center
  px-[1.25em] py-[0.75em]
  transition-colors
  rounded-3xl lg:rounded-4xl
`;

const variantClasses = {
  // hover:bg-[color:var(--color-primary-700)]
  solid: 'bg-brand text-button-text-color text-button',
  outline: 'border border-[color:var(--color-primary-600)] text-[color:var(--color-primary-600)] hover:bg-[color:var(--color-primary-50)]',
};
---

<button class:list={[baseStyles, variantClasses[variant], className]} {...rest}>
  <slot />
</button>
