---
import { Image } from 'astro:assets';
import heroProfile from '../assets/hero-profile.png';
---

<section class="w-full min-h-screen">
  <div class="flex flex-col justify-center items-center px-6 gap-4">
    <div class="w-full flex flex-col md:flex-row justify-center items-center gap-4 md:gap-0 md:justify-between">
      <div class="w-full min-h-0 flex justify-center items-center md:order-last">
        <Image 
          src={heroProfile} 
          alt="Bernardo Alekhine profile with graphic curves"
          loading="eager"
          class="
            w-[clamp(310px,75vw,622px)] lg:w-[clamp(310px,65vh,622px)] max-w-[622px] aspect-square
        "/>
      </div>

      <div class="w-full max-w-xl flex flex-col justify-center items-center gap-2 md:gap-8">
        <h1 class="w-full max-w-[360px] md:max-w-[420px] text-display text-body-color text-center">
          Olá! Meu nome é <span class="text-brand">Bernardo Alekhine</span> Designer Gráfico Profissional de TI
        </h1>
        <p class="w-full max-w-[360px] md:max-w-[500px] text-lead text-body-color text-center">
          Crio soluções visuais combinando tecnologia, criatividade e atenção aos detalhes para comunicar ideias de 
          forma clara e impactante.
        </p>
      </div>
    </div>

    <!-- Down arrow here -->
  </div>
</section>
