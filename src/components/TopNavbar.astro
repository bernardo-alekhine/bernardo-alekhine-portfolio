---
import LogoMonogram from "./icons/LogoMonogram.astro";

const normalizePath = (path: string) => (path !== "/" ? path.replace(/\/$/, "") : path);
const currentPath = normalizePath(Astro.url.pathname);

// Structure data for regular links
const links = [
  { href: "/", label: "Início" },
  { href: "/project-gallery", label: "Projetos" },
  { href: "/profile", label: "Perfil" },
];
---

<nav class="w-full h-13 lg:h-15 fixed top-0 inset-x-0 flex items-center justify-between px-5 bg-nav">
  <a draggable="false" href="/">
    <LogoMonogram class="select-none w-13 lg:w-14" />
  </a>

  <div class="flex-row items-center gap-10 hidden lg:flex">
    {
      links.map(({ href, label }) => {
        const isActive = currentPath === normalizePath(href);

        return (
          <a
            draggable="false"
            href={href}
            aria-current={isActive ? "page" : undefined}
            class:list={[
              "text-top-navbar-anchor text-body-color transition-colors hover:text-brand duration-200 relative pb-3 -mb-3 flex flex-col items-center",
            ]}
          >
            {label}

            {isActive && <span class="absolute bottom-1 w-full h-[2px] bg-brand rounded-full" />}
          </a>
        );
      })
    }

    <a
      draggable="false"
      class="text-top-navbar-anchor text-button-text-color px-6 py-2 rounded-full bg-brand hover:bg-button-primary-hover
             duration-200 transition-[transform,background-color,border-color] active:scale-98 ease-in-out"
      href=""
    >
      Contato
    </a>
  </div>

  <!-- Theme Switch button -->
  <button type="button"></button>
</nav>
