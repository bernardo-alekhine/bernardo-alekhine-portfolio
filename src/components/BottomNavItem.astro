---
interface Props {
  href?: string;
  label?: string;
  isActive?: boolean;
}

const { href = "#", label = "", isActive = false } = Astro.props;
---

<a
  href={href}
  class={`flex flex-col items-center justify-between text-bottom-navbar-anchor transition-colors w-12 h-12 ${
    isActive ? "text-brand" : "text-body-color"
  }`}
>
  <div class="w-6 h-6 flex items-center justify-center shrink-0">
    {isActive ? <slot name="highlight-icon" /> : <slot name="default-icon" />}
  </div>
  <span>{label}</span>
</a>
