---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  label?: string;
  isActive?: boolean;
}

const { href = "#", label = "", isActive = false, class: className, ...restProps } = Astro.props;
---

<a
  href={href}
  class:list={[
    "flex flex-1 flex-col items-center justify-center text-bottom-navbar-anchor text-nav-item transition-colors w-14 h-14 gap-1 select-none",
    isActive ? "text-brand" : "text-body-color",
    className,
  ]}
  {...restProps}
>
  <div class="w-7 h-7 flex items-center justify-center shrink-0 [&>svg]:select-none">
    {isActive ? <slot name="highlight-icon" /> : <slot name="default-icon" />}
  </div>
  <span>{label}</span>
</a>
