---
interface Props {
  href: string;
  label: string;
  isActive: boolean;
  inactiveIcon: string; // SVG path data or SVG string
  activeIcon: string; // SVG path data or SVG string
}

const { href, label, isActive, inactiveIcon, activeIcon } = Astro.props;
---

<a
  href={href}
  class={`flex flex-col items-center gap-1 bottomnavbutton transition-colors ${
    isActive ? "text-indigo-500 font-semibold" : "text-slate-400 hover:text-slate-200"
  }`}
>
  <svg class="w-6 h-6" viewBox="0 0 24 24" aria-hidden="true">
    {
      isActive ? (
        <path class="fill-current" d={activeIcon} />
      ) : (
        <path class="fill-none stroke-current" stroke-width="2" d={inactiveIcon} />
      )
    }
  </svg>
  <span>{label}</span>
</a>
