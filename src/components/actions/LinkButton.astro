---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "solid" | "outline";
  title?: string;
}

const { title, href = "#", variant = "solid", class: className, ...restProps } = Astro.props;

// TODO: Decrease padding and remove large fixed size button width, use percentage to fit parent container intstead
const baseStyles = `
  w-full
  flex
  items-center justify-center
  h-[2.8em]
  px-[1.25em]
  gap-[0.7em]
  text-button
  rounded-3xl lg:rounded-4xl
  select-none
  [&>svg]:select-none
  duration-200
  active:scale-98
  transition-[transform,background-color,border-color]
  ease-in-out
  transition-colors
`;

const variantClasses = {
  solid: "bg-brand text-button-text-color hover:bg-button-primary-hover",
  outline: "border border-brand text-brand hover:border-button-primary-hover hover:bg-button-outline-hover",
};
---

<a href={href} draggable="false" class:list={[baseStyles, variantClasses[variant], className]} {...restProps}>
  <span>{title}</span>
  <slot />
</a>
