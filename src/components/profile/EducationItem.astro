---
interface Props {
  course: string;
  university: string;
  period: string;
  status: string;
  description: string;
}

const { course, university, period, status, description } = Astro.props;
---

<div class="flex flex-col gap-2">
  <p><strong class="text-profile-item-title text-body-color">{course}</strong></p>
  <p class="text-caption text-body-color">{university} | {period} {status}</p>
  <ul><li class="list-disc list-outside text-main-body text-body-color">{description}</li></ul>
</div>
