---
interface Props {
  course: string;
  university: string;
  period: string;
  status: string;
  description: string;
}

const { course, university, period, status, description } = Astro.props;
---

<div class="flex flex-col gap-2">
  <h3 class="text-profile-item-title text-body-color">{course}</h3>
  <p class="text-caption text-body-color">
    {university} | {period} {status}
  </p>
  <ul>
    <li class="list-disc list-outside text-main-body text-body-color">{description}</li>
  </ul>
</div>
