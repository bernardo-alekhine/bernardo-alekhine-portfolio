---
interface Props {
  role: string;
  company: string;
  period: string;
  location: string;
  highlights: string[];
}

const { role, company, period, location, highlights } = Astro.props;
---

<div class="flex flex-col gap-2">
  <p><strong class="text-profile-item-title text-body-color">{role}</strong></p>
  <p class="text-caption text-body-color">{company} | {location} — {period}</p>
  <ul class="flex flex-col gap-1">
    {highlights.map((item) => <li class="list-disc list-outside text-main-body text-body-color">{item}</li>)}
  </ul>
</div>
