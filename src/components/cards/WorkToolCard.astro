---
interface Props {
  title: string;
  svgBg?: string;
}

const { title, svgBg = "bg-card-work-tools" } = Astro.props;
---

<div
  class={`w-full aspect-square flex flex-col items-center text-center justify-center px-4 py-2 gap-2 md:px-3 md:py-3 [&>svg]:select-none rounded-lg
    lg:rounded-xl shadow-md md:shadow-lg shadow-card-shadow-color border border-card-shadow-color/50 transition-colors`}
>
  <div class:list={`w-full md:w-[70%] rounded-lg px-1 py-1 aspect-square ${svgBg}`}>
    <slot />
  </div>
  <strong class="text-xl md:text-card-title text-body-color">{title}</strong>
</div>
