---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class={`w-28 md:w-36 aspect-square flex flex-col items-center text-center justify-between px-3 py-3 lg:px-4 lg:py-4 gap-2 [&>svg]:select-none rounded-lg
    lg:rounded-xl shadow-md shadow-card-shadow-color border border-card-shadow-color/50 transition-colors`}
>
  <div class="w-full md:w-[75%] rounded-lg px-1 py-1 aspect-square my-auto">
    <slot />
  </div>
  <strong class="text-xl md:text-2xl font-normal text-body-color leading-none">{title}</strong>
</div>
