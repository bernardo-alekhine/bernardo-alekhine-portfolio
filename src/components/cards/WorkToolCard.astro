---
interface Props {
  title: string;
  svgBg?: string;
}

const { title, svgBg = "bg-card-work-tools" } = Astro.props;
---

<div
  class={`w-full flex flex-col items-center text-center justify-center px-2 py-2 gap-2 md:py-2 lg:px-8 lg:py-8 [&>svg]:select-none rounded-lg
    lg:rounded-xl shadow-md md:shadow-lg shadow-card-shadow-color border border-lg border-card-shadow-color/50 transition-colors`}
>
  <div class:list={`w-full md:w-[50%] h-auto rounded-lg px-1 py-1 ${svgBg}`}>
    <slot />
  </div>
  <strong class="text-xl md:text-card-title text-body-color">{title}</strong>
</div>
