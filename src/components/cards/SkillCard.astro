---
interface Props {
  class?: string;
  title: string;
  description: string;
}

const { class: className, title, description } = Astro.props;
---

<div
  class:list={[
    "w-full flex flex-col items-center px-6 gap-4 py-8 md:gap-6 lg:px-16 lg:py-12 [&>svg]:select-none rounded-lg lg:rounded-xl \
    shadow-md shadow-card-shadow-color border border-card-shadow-color/50 transition-colors max-w-lg",
    className,
  ]}
>
  <div
    class="flex h-28 w-full items-center justify-center
         [&>svg]:max-h-full [&>svg]:max-w-full
         [&>svg]:h-full [&>svg]:w-auto"
  >
    <slot />
  </div>

  <p class="text-card-title w-full">{title}</p>
  <p class="text-lg w-full">{description}</p>
</div>
