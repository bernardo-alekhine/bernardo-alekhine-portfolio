---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    "flex flex-col items-center px-6 gap-4 py-8 md:gap-6 lg:px-16 lg:py-12 [&>svg]:select-none rounded-lg lg:rounded-xl drop-shadow-lg drop-shadow-card-shadow-color transition-colors",
    className,
  ]}
>
  <slot />
</div>
