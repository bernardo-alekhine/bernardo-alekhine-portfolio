---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

interface Props {
  class?: string;
  project: CollectionEntry<"projects">;
}

const { project, class: className = "" } = Astro.props;
const { title, tagline, coverImage, coverImageAlt, tags } = project.data;
---

<a
  class=`
    w-full max-w-84 flex flex-col justify-center items-center px-6 gap-3 py-8 lg:px-8 lg:py-4 [&>img]:select-none rounded-lg 
    lg:rounded-xl shadow-md shadow-card-shadow-color border border-card-shadow-color/50 transition-colors ${className}
  `
>
  <Image src={coverImage} alt={coverImageAlt} class="select-none rounded-lg" loading="eager" />

  <div class="flex flex-row w-full gap-2">
    {tags.map((tag) => (
      <small class="text-tag bg-card-shadow-color/20 px-2 py-0.5 rounded">{tag}</small>
    ))}
  </div>
  <div class="flex flex-col gap-1">
    <p class="text-body-color text-xl">
      <strong>{title}</strong>
    </p>
    <p class="text-body-color text-lg">{tagline}</p>
  </div>
</a>
