---
import { Image } from "astro:assets";
import heroProfile from "../../assets/hero-profile.png";
import Section from "../Section.astro";
import Container from "../Container.astro";
import Button from "../Button.astro";
import WhatsappIcon from "../icons/Whatsapp.astro";
import ArrowIcon from "../icons/Arrow.astro";
import DownArrow from "../DownArrow.astro";
---

<!-- TODO Have px-6 and xl:px-30 be applied as it is to Section on Container instead (container has max width boundary so content gets pushed to close together if passing to it directly) -->
<Section id="hero">
  <Container class="xl:max-w-[90%] px-6 xl:px-15">
    <div class="flex flex-col xl:flex-row justify-center items-center gap-4 xl:gap-0 xl:justify-between">
      <div class="min-h-0 flex justify-center items-center xl:order-last xl:flex-1 xl:justify-end">
        <Image
          src={heroProfile}
          alt="Bernardo Alekhine profile with graphic curves"
          loading="eager"
          class="w-[clamp(310px,76vmin,600px)] max-w-[450px] xl:max-w-[600px] aspect-square select-none"
        />
      </div>

      <div class="flex-1 flex flex-col max-w-[440px] justify-center items-center gap-2 lg:gap-6">
        <h1 class="max-w-[20ch] text-display text-body-color text-center">
          Olá! Meu nome é <span class="text-brand inline">Bernardo Alekhine</span> Designer Gráfico Profissional de TI
        </h1>
        <p class="max-w-[38ch] text-lead text-body-color text-center">
          Crio soluções visuais combinando tecnologia, criatividade e atenção aos detalhes para comunicar ideias de
          forma clara e impactante.
        </p>

        <div class="w-full flex flex-col justify-center items-center gap-4 py-5 lg:py-1" id="buttons">
          <Button variant="solid">
            <span>Ver Projetos</span>
            <ArrowIcon class="text-button-text-color" />
          </Button>
          <Button variant="outline">
            <span>Falar no WhatsApp</span>
            <WhatsappIcon />
          </Button>
        </div>
      </div>
    </div>
  </Container>
  <DownArrow />
</Section>
