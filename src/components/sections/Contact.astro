---
import Section from "../Section.astro";
import Container from "../Container.astro";
import SectionBanner from "../SectionBanner.astro";
import ContactItem from "../actions/ContactItem.astro";
import WhatsAppIcon from "../icons/contact/WhatsAppLogo.astro";
import LinkedInIcon from "../icons/contact/LinkedIn.astro";
import Email from "../icons/contact/Email.astro";
import GitHubIcon from "../icons/GitHub.astro";
---

<Section id="contact">
  <SectionBanner>
    <h6 class="text-heading text-brand">Canais de Contato</h6>
  </SectionBanner>
  <Container class="flex flex-col items-center">
    <div
      class="grid grid-cols-1 md:grid-cols-2 justify-center
      shadow-md shadow-card-shadow-color border border-card-shadow-color/50
      rounded-lg lg:rounded-xl
      px-2 py-2 gap-2 md:px-4 md:py-4 md:gap-30"
    >
      <ContactItem
        value="+55 38 99855-2879"
        target="_blank"
        rel="noopener noreferrer"
        href="https://wa.me/5538998552879"
      >
        <WhatsAppIcon />
      </ContactItem>
    </div>
  </Container>
</Section>
