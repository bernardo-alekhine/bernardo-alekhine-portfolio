---
import { Image } from "astro:assets";
import heroProfile from "../../assets/hero-profile.png";
import Section from "@components/Section.astro";
import Container from "@components/Container.astro";
import FadeIn from "@components/FadeIn.astro";
import LinkButton from "@components/actions/LinkButton.astro";
import WhatsAppIcon from "@components/icons/WhatsApp.astro";
import ArrowIcon from "@components/icons/Arrow.astro";
import DownArrow from "@components/actions/DownArrow.astro";
---

<Section class="xl:min-h-dvh justify-center gap-4 2xl:gap-6" id="hero">
  <Container>
    <FadeIn delay="delay-150">
      <div>
        <div class="flex flex-col xl:flex-row justify-center items-center gap-3 xl:gap-0">
          <div class="flex flex-col min-h-0 justify-center items-center xl:order-last xl:flex-1 xl:justify-end">
            <Image
              src={heroProfile}
              alt="Foto de perfil do Bernardo Alekhine com elementos gráficos."
              loading="eager"
              class="w-[clamp(310px,76vmin,600px)] max-w-112.5 xl:max-w-150 aspect-square select-none"
            />
          </div>

          <div class="w-full flex-1 flex flex-col justify-center items-center gap-4 lg:gap-5">
            <div class="w-full justify-center items-center flex flex-col gap-4 lg:gap-5">
              <div class="w-full justify-center items-center">
                <h1 class="w-full flex flex-col max-w-[19ch] text-display text-body-color text-center mx-auto">
                  Olá! Meu nome é <span class="text-brand inline">Bernardo Alekhine</span>
                </h1>

                <div class="w-full flex flex-col xl:max-w-[22ch] mx-auto text-display text-body-color text-center">
                  <div class="sm:hidden flex flex-col mx-auto">
                    <span>Programador</span>
                    <span>Designer</span>
                  </div>
                  <div class="hidden sm:block">
                    <span>Programador</span>
                    <span class="mx-2">|</span>
                    <span>Designer</span>
                  </div>
                  <span class="mx-auto">Soluções em TI</span>
                </div>
              </div>

              <p class="max-w-[50ch] xl:max-w-[40ch] text-lead text-body-color text-center">
                Crio soluções tecnológicas e visuais combinando desenvolvimento de software, infraestrutura de TI e
                design para transformar ideias em projetos integrados de forma clara e eficiente.
              </p>
            </div>

            <div
              class="w-full max-w-110 lg:max-w-140 2xl:max-w-162.5 flex flex-col justify-center items-center gap-3 py-5 lg:py-1"
              id="buttons"
            >
              <LinkButton title="Ver Projetos" href="/projects" variant="solid">
                <ArrowIcon class="text-button-text-color" />
              </LinkButton>
              <LinkButton
                title="Falar no WhatsApp"
                href="https://wa.me/5538998552879"
                target="_blank"
                rel="noopener noreferrer"
                variant="outline"
              >
                <WhatsAppIcon class="fill-current" />
              </LinkButton>
            </div>
          </div>
        </div>
      </div>
    </FadeIn>
  </Container>

  <FadeIn delay="delay-300">
    <DownArrow href="/#featured-projects" class="hidden xl:block" />
  </FadeIn>
</Section>
