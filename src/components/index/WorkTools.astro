---
import SectionBanner from "@components/SectionBanner.astro";
import WorkToolsContainer from "@components/WorkToolsContainer.astro";
import WorkToolCard from "@components/cards/WorkToolCard.astro";
import AffinityIcon from "@components/icons/work-tools/Affinity.astro";
import AstroIcon from "@components/icons/work-tools/Astro.astro";
import CorelDrawIcon from "@components/icons/work-tools/CorelDraw.astro";
import DockerIcon from "@components/icons/work-tools/Docker.astro";
import FigmaIcon from "@components/icons/work-tools/Figma.astro";
import GitHubIcon from "@components/icons/GitHub.astro";
import PythonIcon from "@components/icons/work-tools/Python.astro";
import JavaScriptIcon from "@components/icons/work-tools/JavaScript.astro";
import SQLIcon from "@components/icons/work-tools/SQL.astro";
import TailwindIcon from "@components/icons/work-tools/TailwindCSS.astro";
---

<div class="flex flex-col gap-2 pt-12 pb-3" id="work-tools">
  <SectionBanner>
    <h2 class="text-heading text-body-color w-full text-center">Minhas Ferramentas de Trabalho</h2>
  </SectionBanner>

  <div class="flex flex-col text-center gap-6">
    <div class="flex flex-col px-1 gap-6">
      <p>
        <strong class="text-subheading font-medium tracking-wide text-body-color">Design Gráfico</strong>
      </p>
      <WorkToolsContainer>
        <WorkToolCard title="Affinity">
          <AffinityIcon />
        </WorkToolCard>

        <WorkToolCard title="CorelDraw">
          <CorelDrawIcon />
        </WorkToolCard>

        <WorkToolCard title="Figma">
          <FigmaIcon />
        </WorkToolCard>
      </WorkToolsContainer>
    </div>

    <div class="flex flex-col py-8 px-1 gap-6">
      <p>
        <strong class="text-subheading font-medium tracking-wide text-body-color">Desenvolvimento</strong>
      </p>

      <WorkToolsContainer>
        <WorkToolCard title="Python">
          <PythonIcon />
        </WorkToolCard>

        <WorkToolCard title="JavaScript">
          <JavaScriptIcon />
        </WorkToolCard>

        <WorkToolCard title="SQL">
          <SQLIcon />
        </WorkToolCard>

        <WorkToolCard title="Astro">
          <AstroIcon />
        </WorkToolCard>

        <WorkToolCard title="Tailwind CSS">
          <TailwindIcon />
        </WorkToolCard>

        <WorkToolCard title="Docker">
          <DockerIcon />
        </WorkToolCard>

        <WorkToolCard title="GitHub">
          <GitHubIcon />
        </WorkToolCard>
      </WorkToolsContainer>
    </div>
  </div>
</div>
