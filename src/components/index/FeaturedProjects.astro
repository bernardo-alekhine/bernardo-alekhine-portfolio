---
import Section from "../Section.astro";
import SectionBanner from "../SectionBanner.astro";
import FadeIn from "../FadeIn.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../cards/ProjectCard.astro";

const featuredProjects = await getCollection("projects", ({ data }) => {
  return data.featured === true;
});

const sortedProjects = featuredProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Section class="gap-6" id="featured-projects">
  <SectionBanner class="bg-section-banner">
    <h2 class="text-heading text-body-color">Projetos em Destaque</h2>
    <p class="text-lead text-body-color">
      Uma seleção de projetos recentes desenvolvidos com foco em clareza e impacto visual.
    </p>
  </SectionBanner>

  <div class="w-full flex flex-wrap gap-6 items-center justify-center justify-items-center px-2 md:px-">
    <FadeIn>
      {sortedProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </FadeIn>
  </div>
</Section>
