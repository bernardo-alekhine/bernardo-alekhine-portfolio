---
import Section from "../Section.astro";
import Container from "../Container.astro";
import SectionBanner from "../SectionBanner.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../cards/ProjectCard.astro";

const projects = await getCollection("projects");
---

<Section class="gap-6" id="featured-projects">
  <SectionBanner class="bg-section-banner">
    <h2 class="text-heading text-body-color">Projetos em Destaque</h2>
    <p class="text-lead text-body-color">
      Uma seleção de projetos recentes desenvolvidos com foco em clareza e impacto visual.
    </p>
  </SectionBanner>

  <!-- Keep ongoing card development hidden before working on major changes -->
  <Container class="hidden w-full grid-cols-1 md:grid-cols-3 justify-center justify-items-center px-2 md:px-12">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </Container>
</Section>
