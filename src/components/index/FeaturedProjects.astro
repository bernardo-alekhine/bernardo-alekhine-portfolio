---
import Section from "@components/Section.astro";
import SectionBanner from "@components/SectionBanner.astro";
import FadeIn from "@components/FadeIn.astro";
import { getCollection } from "astro:content";
import ProjectCard from "@components/cards/ProjectCard.astro";

const featuredProjects = await getCollection("projects", ({ data }) => {
  return data.featured === true;
});

const sortedProjects = featuredProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Section class="gap-6" id="featured-projects">
  <SectionBanner class="bg-section-banner">
    <h2 class="text-heading text-body-color">Projetos em Destaque</h2>
    <p class="text-lead text-body-color">
      Uma seleção de projetos recentes que unem desenvolvimento de software, interfaces intuitivas e soluções visuais
      focadas em funcionalidade, clareza e impacto.
    </p>
  </SectionBanner>

  <FadeIn>
    <div class="w-full flex flex-wrap gap-6 items-center justify-center justify-items-center px-2 md:px-">
      {sortedProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </FadeIn>
</Section>
