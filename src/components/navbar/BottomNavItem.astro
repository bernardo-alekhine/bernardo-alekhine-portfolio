---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  label?: string;
  isActive?: boolean;
}

const { href = "#", label = "", class: className, ...restProps } = Astro.props;
const normalizePath = (path: string) => (path !== "/" ? path.replace(/\/$/, "") : path);

const currentPath = normalizePath(Astro.url.pathname);
const targetPath = normalizePath(String(href));
const isActive =
  targetPath === "/" ? currentPath === "/" : currentPath === targetPath || currentPath.startsWith(`${targetPath}/`);
---

<a
  href={href}
  data-active={isActive}
  class:list={[
    "group flex flex-1 flex-col items-center justify-center text-bottom-navbar-anchor transition-colors w-14 h-14 gap-1 select-none",
    "duration-200",
    "data-[active=true]:text-brand data-[active=false]:text-body-color",
    className,
  ]}
  {...restProps}
>
  <div
    transition:name={`nav-pill-${label}`}
    transition:animate="initial"
    class="relative w-13 h-8 flex items-center justify-center shrink-0 [&>svg]:select-none rounded-full
      transition-all duration-500 group-data-[active=true]:bg-brand/10"
  >
    <div
      class="absolute inset-0 flex items-center justify-center transition-all duration-500 opacity-0
      scale-90 group-data-[active=true]:opacity-100 group-data-[active=true]:scale-100 pointer-events-none"
    >
      <slot name="highlight-icon" />
    </div>

    <div
      class="absolute inset-0 flex items-center justify-center transition-all duration-500 opacity-100
      scale-100 group-data-[active=true]:opacity-0 group-data-[active=true]:scale-90"
    >
      <slot name="default-icon" />
    </div>
  </div>
  <span>{label}</span>
</a>
