---
import TopNavbar from "./TopNavbar.astro";
import BottomNavbar from "./BottomNavbar.astro";
---

<header class="sticky top-0 z-50 w-full flex flex-col">
  <TopNavbar />
  <!-- Hide bottom navbar on desktop screens -->
  <BottomNavbar class="lg:hidden [@media(hover:hover)and(pointer:fine)and(max-md:block)]:hidden" />
</header>
