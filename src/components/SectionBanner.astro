---
import Container from "./Container.astro";
import TextWrapper from "./TextWrapper.astro";

interface Props {
  class?: string;
  align?: "center" | "left";
}

const { class: className, align = "center" } = Astro.props;

const alignmentClasses = {
  center: "items-center text-center",
  left: "items-start text-left",
};
---

<div class:list={["w-full", className]}>
  <Container class=`flex flex-col gap-4 py-8 ${alignmentClasses[align]}`>
    <TextWrapper class="flex flex-col gap-2">
      <slot />
    </TextWrapper>
  </Container>
</div>
