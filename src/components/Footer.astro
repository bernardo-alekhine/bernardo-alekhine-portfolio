          <clipPath id="clip0_509_3209">
            <rect width="104" height="67" fill="white" transform="translate(0 19)"></rect>
          </clipPath>
        </defs>
      </svg>
    </div>

    <div class="flex flex-col items-center gap-2">
      <h1 class="text-footer text-footer-fg text-center">
        Desenvolvimento de sistemas robustos & Design de marcas com propósito.
      </h1>
      <h2 class="text-body text-footer-fg text-center">© 2026 Bernardo Alekhine. Todos os direitos reservados.</h2>
    </div>
  </div>
</footer>
