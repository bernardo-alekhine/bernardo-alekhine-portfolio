---
import CopyEmailButton from "./actions/CopyEmailButton.astro";
---

<footer
  class="w-full flex flex-col justify-between items-center gap-8 lg:gap-10 px-6 lg:px-24 py-16 pb-26 lg:pb-12 bg-footer-bg"
>
  <div
    class="w-full flex flex-1 flex-row gap-17 md:gap-20 justify-center items-start px-8 xl:gap-0 xl:justify-between lg:px-12"
  >
    <div class="flex flex-col items-start gap-4">
      <p class="text-main-body text-body-color tracking-wide mb-1 select-none">Contato</p>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="https://wa.me/5538998552879"
        target="_blank"
        rel="noopener noreferrer"
      >
        WhatsApp
      </a>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
        href="https://www.linkedin.com/in/bernardo-alekhine/"
      >
        LinkedIn
      </a>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/bernardo-alekhine"
      >
        GitHub
      </a>
      <CopyEmailButton
        email="alekhinebernardo@gmail.com"
        label="Copiar Email"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
      />
    </div>

    <div class="hidden md:flex flex-col items-start gap-4">
      <p class="text-main-body text-body-color tracking-wide mb-1 select-none">Recursos</p>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="#"
      >
        Projetos em Destaque
      </a>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="#"
      >
        Serviços
      </a>
      <a
        target="_blank"
        rel="noopener noreferrer"
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="#"
      >
        Baixar Currículo
      </a>
    </div>

    <div class="flex flex-col items-start gap-4">
      <p class="text-main-body text-body-color tracking-wide mb-1 select-none">Navegação</p>
      <a class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200" href="/"> Início </a>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="/project-gallery"
      >
        Projetos
      </a>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="#"
      >
        Contato
      </a>
      <a
        draggable="false"
        class="text-footer-link text-brand hover:text-brand-hover transition-colors duration-200"
        href="/profile"
      >
        Perfil
      </a>
    </div>
  </div>

  <div class="flex flex-col items-center gap-4">
    <div class="w-22 h-22 lg:w-24 lg:h-24">
      <svg
        class="w-full h-full fill-footer-fg select-none focus:outline-none pointer-events-none"
        width="104"
        height="104"
        viewBox="0 0 104 104"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
