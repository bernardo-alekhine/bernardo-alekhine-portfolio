---
import type { HTMLAttributes } from "astro/types";
import BottomNavItem from "./BottomNavItem.astro";

type Props = HTMLAttributes<"button">;

const { class: className, ...props } = Astro.props;
---

<nav class:list={["w-full h-18 flex items-center fixed bottom-0 inset-x-0 px-5 bg-nav", className]} {...props}>
