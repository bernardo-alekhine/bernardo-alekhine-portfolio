    <svg
      class="w-full h-full fill-nav-item"
      width="34"
      height="26"
      viewBox="0 0 34 26"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      slot="default-icon"
    >
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M16.6059 2.75797H28.6426C31.5681 2.75797 34 5.5631 34 9.08596V19.672C34 23.1949 31.5681 26 28.6426 26H5.35742C2.43191 26 0 23.1949 0 19.672V9.08596C0 8.80921 0.0151013 8.53658 0.044242 8.27049V3.21642C0.044242 1.40946 1.317 0 2.81757 0H13.7427C14.1814 0 14.6059 0.206284 14.9069 0.590435L16.6059 2.75797ZM13.5501 2.07007H2.81757C2.31605 2.07007 1.9679 2.61249 1.9679 3.21642V8.3992L1.96021 8.46441C1.93614 8.66742 1.92378 8.87499 1.92378 9.08596V19.672C1.92378 21.9921 3.43072 23.9301 5.35742 23.9301H28.6426C30.5693 23.9301 32.0763 21.9921 32.0763 19.672V9.08596C32.0763 6.76585 30.5693 4.8279 28.6426 4.8279H15.7118L13.5501 2.07007Z"
      ></path>
    </svg>

    <!-- Highlight SVG -->
    <svg slot="highlight-icon"></svg>
  </BottomNavItem>

